{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parking-rush-hour-slide.schema.json",
  "title": "Parking-lot escape problem (Rush Hour slide) v1",
  "type": "object",
  "required": ["schema_version", "puzzle_type", "generator_version", "width", "height", "vehicles", "target_id", "exit_side", "ruleset"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "puzzle_type": {"const": "parking"},
    "generator_version": {"const": "parking-gen-1"},
    "ruleset": {"const": "rush-hour-slide-v1"},
    "exit_side": {"const": "east"},
    "width": {"type": "integer", "minimum": 4, "maximum": 8},
    "height": {"type": "integer", "minimum": 4, "maximum": 8},
    "target_id": {"type": "integer", "minimum": 0},
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "prefixItems": [
          {"type": "integer", "minimum": 0, "description": "x of the head cell"},
          {"type": "integer", "minimum": 0, "description": "y of the head cell"},
          {"type": "integer", "minimum": 2, "maximum": 3, "description": "length in cells"},
          {"enum": ["H", "V"], "description": "slide axis"},
          {"type": "integer", "minimum": 0, "description": "vehicle id"}
        ]
      }
    }
  },
  "additionalProperties": false
}

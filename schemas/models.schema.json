  "$id": "models.schema.json",
  "title": "Zero Button Game logical documents",
  "type": "object",
  "oneOf": [
    {"required": ["schema_version", "puzzle_type", "generator_version", "width", "height", "start", "goal", "edges"]},
    {"required": ["schema_version", "puzzle_type", "generator_version", "width", "height", "source", "sink", "initial_masks", "ruleset"]},
